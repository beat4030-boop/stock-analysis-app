# 키움증권 REST API 설정
# https://openapi.koreainvestment.com 에서 발급받은 키
KIWOOM_APP_KEY=your_app_key_here
KIWOOM_APP_SECRET=your_app_secret_here

# 실전투자: https://openapi.koreainvestment.com:9443
# 모의투자: https://openapi.koreainvestment.com:29443
KIWOOM_BASE_URL=https://openapi.koreainvestment.com:29443

# 계좌번호 (XXXXXXXX-XX 형식)
KIWOOM_ACCOUNT_NO=00000000-01

# 모의투자 여부 (true/false)
IS_PAPER_TRADING=true
